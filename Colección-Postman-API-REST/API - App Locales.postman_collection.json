          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/locales",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "locales"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Local ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/locales/:id",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "locales",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "4"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Local",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "\r",
                  "let aforo = pm.environment.replaceIn(\"{{$randomInt}}\")\r",
                  "let longitud = pm.environment.replaceIn(\"{{$randomLongitude}}\")\r",
                  "let latitud = pm.environment.replaceIn(\"{{$randomLatitude}}\")\r",
                  "\r",
                  "pm.environment.set(\"aforo\",aforo)\r",
                  "pm.environment.set(\"longitud\",longitud)\r",
                  "pm.environment.set(\"latitud\",latitud)\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"local\":\"{{local}}\",\r\n    \"nombre\":\"{{nombre}}\",\r\n    \"aforo\":{{aforo}},\r\n    \"longitud\": {{longitud}},\r\n    \"latitud\": {{latitud}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{host}}/api/locales",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "locales"
              ]
            }
          },
          "response": []
        }
      ]
